// MosaiCxM desktop UI: one screen with four colour-coded steps on the left
// and the preview always visible on the right.
//
// Colour coding (also in the README):
//   1 Photos        teal
//   2 Picture       coral
//   3 Size & style  amber
//   4 Export        violet
//   5 Statistics    blue

import { Button, LineEdit, SpinBox, Slider, CheckBox, ComboBox, ScrollView, Palette, Switch } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export struct FolderRow {
    path: string,
    collection: string,
    missing: bool,
}

export struct CollectionRow {
    name: string,
    summary: string,
    selected: bool,
}

export struct Bar {
    label: string,
    value: string,
    frac: float,
}

export struct Chart {
    title: string,
    note: string,
    bars: [Bar],
}

export struct Figure {
    label: string,
    value: string,
}

// One page of the Help view. Text is in Simplified Technical English
// (ASD-STE100 style): short sentences, one instruction per step.
export struct HelpTopic {
    title: string,
    tint: color,
    picture: image,
    intro: string,
    steps: [string],
    notes: [string],
}

export struct SuggestionRow {
    label: string,
    path: string,
    score: string,
    notes: string,
    picture: image,
    preview: image,
    has-preview: bool,
}

// A tile drawn with an outline on the preview (fractions of the mosaic).
export struct TileMark {
    u: float,
    v: float,
    w: float,
    h: float,
    current: bool,
}

// The photo of the tile the user clicked in the preview.
export struct TileInfo {
    open: bool,
    picture: image,
    name: string,
    date: string,
    folder: string,
    uses: string,
    place: string,
    distance: string,
    has-file: bool,
    more: bool,
}

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #12161f : #f6f7fb;
    out property <color> surface: dark ? #1a202c : #ffffff;
    out property <color> line: dark ? #2c3445 : #dfe3ec;
    out property <color> fg: dark ? #e7eaf2 : #1d2433;
    out property <color> muted: dark ? #9aa3b5 : #5d6577;
    out property <color> ink: dark ? #0d1118 : #1f2a3c;

    out property <color> teal: dark ? #2cc2ad : #0f9d8a;
    out property <color> coral: dark ? #ff7b70 : #e2493d;
    out property <color> amber: dark ? #f4bb42 : #d99400;
    out property <color> violet: dark ? #9487ff : #6c5ce7;

    out property <color> teal-soft: dark ? #123a35 : #dff4f0;
    out property <color> coral-soft: dark ? #42201d : #fde5e2;
    out property <color> amber-soft: dark ? #3d3114 : #fcf0d6;
    out property <color> violet-soft: dark ? #2a2550 : #e9e6fd;
    out property <color> blue: dark ? #5aa9ff : #2774d9;
    out property <color> blue-soft: dark ? #15304f : #e0eefc;
    // Neutral marker colour (Help "Start here"); stays visible in dark mode.
    out property <color> neutral: dark ? #56607a : #1f2a3c;

    // Bar colours for the statistics charts, one per chart.
    out property <[color]> chart-colors: [blue, teal, coral, amber, violet, blue, teal, coral];
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// Dark box shown inside every tooltip. The text wraps at 300 px.
component TipBox inherits Rectangle {
    in property <string> text;
    background: #1f2a3c;
    border-radius: 6px;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            width: min(300px, measure.preferred-width);
            wrap: word-wrap;
            color: #ffffff;
            font-size: 12px;
        }
    }
    measure := Text { text: root.text; font-size: 12px; visible: false; x: 0; y: 0; width: 0; height: 0; }
}

// Wraps any control so that pointing at it shows `tip` as a tooltip.
component Tipped inherits Rectangle {
    in property <string> tip;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        @children
    }
    Tooltip { TipBox { text: root.tip; } }
}

// Small "?" circle that marks a control with a tooltip.
component HelpDot inherits Rectangle {
    width: 16px;
    min-height: 16px;
    Rectangle {
        width: 16px;
        height: 16px;
        y: (parent.height - 16px) / 2;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.muted;
        Text { text: "?"; color: Theme.muted; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

component Label inherits Text {
    color: Theme.fg;
    vertical-alignment: center;
}

// Label plus control(s) on one row. Pointing at the label shows `tip`.
component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> tip;
    spacing: 8px;
    Tipped {
        tip: root.tip;
        min-width: 120px;
        Label { text: root.label; font-size: 13px; }
        if root.tip != "": HelpDot { }
    }
    @children
}

// Full-width controls for longer settings inside the narrow sidebar.
component StackedField inherits VerticalLayout {
    in property <string> label;
    in property <string> tip;
    spacing: 5px;
    Tipped {
        tip: root.tip;
        min-height: 18px;
        Label { text: root.label; font-size: 12px; font-weight: 600; }
        if root.tip != "": HelpDot { }
    }
    @children
}

// Check box or switch with a "?" and a tooltip.
component TipCheck inherits Tipped {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> switch;
    in property <bool> enabled: true;
    callback toggled();
    if !root.switch: CheckBox { text: root.text; checked <=> root.checked; enabled: root.enabled; toggled => { root.toggled(); } }
    if root.switch: Switch { text: root.text; checked <=> root.checked; enabled: root.enabled; toggled => { root.toggled(); } }
    HelpDot { }
}

// Small square button with up/down arrows: swaps width and height.
component SwapButton inherits Rectangle {
    in property <string> tooltip-text;
    callback clicked();
    width: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.surface.darker(0.05) : Theme.surface;
    accessible-role: button;
    accessible-label: root.tooltip-text;
    accessible-action-default => { root.clicked(); }
    Path {
        width: 16px;
        height: 22px;
        viewbox-width: 16;
        viewbox-height: 22;
        stroke: Theme.fg;
        stroke-width: 1.6px;
        fill: transparent;
        // Up arrow on the left, down arrow on the right.
        commands: "M 4 20 L 4 2 M 1 5 L 4 2 L 7 5 M 12 2 L 12 20 M 9 17 L 12 20 L 15 17";
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { TipBox { text: root.tooltip-text; } }
}

// Filled button in a step colour.
component ColorButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.teal;
    in property <bool> enabled: true;
    callback clicked();
    min-width: label.preferred-width + 28px;
    height: 32px;
    border-radius: 8px;
    background: !root.enabled ? Theme.line : ta.pressed ? root.tint.darker(0.2) : ta.has-hover ? root.tint.brighter(0.1) : root.tint;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        color: root.enabled ? #ffffff : Theme.muted;
        font-weight: 600;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Text-only button, used for "Advanced", "Why?" and similar small actions.
component LinkButton inherits Text {
    callback clicked();
    in property <color> tint: Theme.muted;
    in property <bool> enabled: true;
    color: !root.enabled ? Theme.muted : ta.has-hover ? Theme.fg : root.tint;
    opacity: root.enabled ? 1.0 : 0.5;
    font-size: 12px;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// One row of the Help menu. `mark` shows a tick for on/off items.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> mark;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: ma.has-hover && root.enabled ? Theme.line : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        Text { width: 16px; text: root.mark; color: Theme.teal; font-weight: 700; font-size: 13px; vertical-alignment: center; }
        Text { text: root.text; color: root.enabled ? Theme.fg : Theme.muted; font-size: 13px; vertical-alignment: center; }
    }
    ma := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Collapsible "Advanced" box inside a step card: its own background and a
// border in the step colour, so it stands out from the card around it.
// Put the content in as `if root.<flag>: VerticalLayout { ... }`.
component AdvancedPanel inherits Rectangle {
    in property <string> text;
    in property <bool> expanded;
    in property <color> tint: Theme.amber;
    callback toggled();
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? root.tint : root.tint.with-alpha(0.6);
    background: Theme.surface;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 22px;
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.expanded ? "▾" : "▸"; color: root.tint; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                Text { text: "Advanced"; color: root.tint; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                Text { text: root.text; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
        }
        @children
    }
}

// Segmented control: one choice out of a few.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <[string]> tips;
    in-out property <int> current: 0;
    in property <color> tint: Theme.amber;
    callback changed(int);
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    HorizontalLayout {
        for opt[i] in root.options: Rectangle {
            background: i == root.current ? root.tint : (t.has-hover ? Theme.bg : Theme.surface);
            Text {
                text: opt;
                font-size: 12px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? #ffffff : Theme.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
            Tooltip { TipBox { text: root.tips[i]; } }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> dot: Theme.teal;
    height: 26px;
    min-width: lbl.preferred-width + 34px;
    border-radius: 13px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        Rectangle { width: 8px; height: 8px; y: (parent.height - 8px) / 2; border-radius: 4px; background: root.dot; }
        lbl := Text { text: root.text; font-size: 12px; color: Theme.fg; vertical-alignment: center; }
    }
}

// Header line of a step card: coloured number (or tick), title, summary.
component StepHeader inherits Rectangle {
    in property <string> number;
    in property <string> title;
    in property <string> summary;
    in property <bool> done;
    in property <color> tint;
    in property <string> tip;
    callback clicked();
    height: 30px;
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tooltip { TipBox { text: root.tip; } }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 26px;
            height: 26px;
            y: 2px;
            border-radius: 13px;
            background: root.tint;
            Text { text: root.done ? "✓" : root.number; color: #ffffff; font-weight: 700; font-size: 13px; }
        }
        Text { text: root.title; font-weight: 600; font-size: 15px; color: Theme.fg; vertical-alignment: center; }
        Text { text: root.summary; font-size: 12px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component StepCard inherits Rectangle {
    in property <bool> open;
    in property <color> tint;
    in property <color> soft;
    border-radius: 10px;
    border-width: root.open ? 2px : 1px;
    border-color: root.open ? root.tint : Theme.line;
    background: root.open ? root.soft : Theme.surface;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        @children
    }
}

component FigureTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.blue;
    min-width: 150px;
    height: 76px;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle { x: 0; width: 4px; height: parent.height - 24px; y: 12px; border-radius: 2px; background: root.tint; }
    VerticalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 2px;
        Text { text: root.value; font-size: 22px; font-weight: 700; color: Theme.fg; overflow: elide; }
        Text { text: root.label; font-size: 12px; color: Theme.muted; overflow: elide; }
    }
}

// Horizontal bar chart: one row per value, bar length relative to the largest.
component BarChart inherits Rectangle {
    in property <Chart> chart;
    in property <color> tint: Theme.blue;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text { text: root.chart.title; font-size: 14px; font-weight: 600; color: Theme.fg; }
        if root.chart.note != "": Text { text: root.chart.note; font-size: 11px; color: Theme.muted; overflow: elide; }
        if root.chart.bars.length == 0: Text { text: "No data"; font-size: 12px; color: Theme.muted; }
        for b in root.chart.bars: HorizontalLayout {
            spacing: 8px;
            height: 22px;
            Text { text: b.label; width: 120px; font-size: 12px; color: Theme.fg; vertical-alignment: center; overflow: elide; }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle { height: 14px; y: 4px; width: parent.width; border-radius: 4px; background: Theme.bg; }
                Rectangle {
                    x: 0;
                    height: 14px;
                    y: 4px;
                    width: max(4px, parent.width * b.frac);
                    border-radius: 4px;
                    background: root.tint;
                    animate width { duration: 400ms; easing: ease-out; }
                }
            }
            Text { text: b.value; width: 52px; font-size: 12px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
}

// Spinning wheel shown in the status bar while a job runs: 8 dots, the bright one goes round.
component Spinner inherits Rectangle {
    width: 18px;
    height: 18px;
    property <float> step: Math.mod(animation-tick() / 90ms, 8);
    for i in 8: Rectangle {
        property <angle> a: i * 45deg;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        x: parent.width / 2 + 7px * Math.cos(a) - self.width / 2;
        y: parent.height / 2 + 7px * Math.sin(a) - self.height / 2;
        background: Theme.teal;
        opacity: 0.2 + 0.8 * (1 - Math.mod(step - i + 8, 8) / 8);
    }
}

// Small button drawn over the preview.
component OverlayButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    width: max(30px, t.preferred-width + 18px);
    height: 30px;
    border-radius: 7px;
    background: ta.pressed ? Theme.line : root.active ? Theme.amber-soft : Theme.surface;
    border-width: 1px;
    border-color: root.active ? Theme.amber : Theme.line;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    t := Text { text: root.text; color: root.enabled ? Theme.fg : Theme.muted; font-size: 13px; font-weight: 600; }
    Tooltip { TipBox { text: root.tip; } }
}

// The mosaic preview. Scroll or double-click to zoom, drag to move.
// cx and cy are the centre of the view as fractions (0..1) of the mosaic.
// After the view stops moving, the app sends a sharp image ("detail") of the
// visible area, made from the original photos, and it is drawn over the
// scaled-up preview.
component ZoomView inherits Rectangle {
    in property <image> base;
    in property <image> detail;
    in property <bool> has-detail;
    in property <[float]> detail-uv: [0, 0, 1, 1];
    in property <bool> sharpening;
    in property <string> hover-label;
    in property <float> max-zoom: 8;
    in property <float> dim: 1.0;
    in-out property <float> zoom: 1;
    in-out property <float> cx: 0.5;
    in-out property <float> cy: 0.5;
    // Width of the printed mosaic in mm, for "View from".
    in property <float> artwork-mm;
    // Number of tiles that look soft from 1 m, 3 m and 5 m.
    in property <[int]> soft-tiles: [0, 0, 0];
    // Simulated viewing distance in metres; 0 when the user zooms freely.
    in-out property <float> distance: 0;
    // zoom, centre, mosaic size on screen, view size.
    callback view-changed(float, float, float, length, length, length, length);
    // Mouse position as fractions of the mosaic.
    callback hover(float, float);
    // Click on a tile (not a drag or a double-click), as fractions of the mosaic.
    in property <TileInfo> info;
    in property <[TileMark]> marks;
    // Move the view to (goto-u, goto-v) each time goto-n changes.
    in property <float> goto-u;
    in property <float> goto-v;
    in property <int> goto-n;
    changed goto-n => {
        root.cx = root.goto-u;
        root.cy = root.goto-v;
        root.settle();
    }
    callback tile-clicked(float, float);
    callback tile-inspect(float, float);
    callback open-photo();
    callback show-folder();
    callback next-use();
    callback close-info();
    clip: true;
    property <float> click-u;
    property <float> click-v;
    property <bool> primary-press;
    // The photo box goes on the side away from the clicked tile.
    property <bool> card-right;

    property <float> aspect: root.base.height > 0 ? root.base.width / (root.base.height * 1.0) : 1;
    property <length> fit-w: min(root.width, root.height * root.aspect);
    property <length> img-w: root.fit-w * root.zoom;
    property <length> img-h: root.fit-w / root.aspect * root.zoom;
    property <length> img-x: root.width / 2 - root.cx * root.img-w;
    property <length> img-y: root.height / 2 - root.cy * root.img-h;
    property <float> press-cx;
    property <float> press-cy;

    // Keeps the mosaic on screen and tells the app what is visible.
    function settle() {
        if root.img-w <= 0px || root.img-h <= 0px {
            return;
        }
        root.cx = root.img-w <= root.width ? 0.5 : clamp(root.cx, root.width / root.img-w / 2, 1 - root.width / root.img-w / 2);
        root.cy = root.img-h <= root.height ? 0.5 : clamp(root.cy, root.height / root.img-h / 2, 1 - root.height / root.img-h / 2);
        root.view-changed(root.zoom, root.cx, root.cy, root.img-w, root.img-h, root.width, root.height);
        // The photo under the mouse changes when the view moves.
        if ta.has-hover {
            root.hover((ta.mouse-x - root.img-x) / root.img-w, (ta.mouse-y - root.img-y) / root.img-h);
        }
    }
    // Zooms by `factor`, keeping the point (px, py) of the view in place.
    function zoom-at(factor: float, px: length, py: length) {
        if root.img-w <= 0px || root.img-h <= 0px {
            return;
        }
        let u = (px - root.img-x) / root.img-w;
        let v = (py - root.img-y) / root.img-h;
        root.distance = 0;
        root.zoom = clamp(root.zoom * factor, 1, root.max-zoom);
        root.cx = u + (root.width / 2 - px) / root.img-w;
        root.cy = v + (root.height / 2 - py) / root.img-h;
        root.settle();
    }
    function fit() {
        root.distance = 0;
        root.zoom = 1;
        root.cx = 0.5;
        root.cy = 0.5;
        root.settle();
    }
    // Shows the mosaic as a person `d` metres away sees it. The view stands
    // for 40° of sight, about what the eyes take in at one time:
    // 2 · d · tan(20°) = 0.728 · d metres of wall.
    function view-from(d: float) {
        if root.fit-w <= 0px || d <= 0 {
            return;
        }
        root.distance = d;
        root.zoom = clamp(root.width / root.fit-w * root.artwork-mm / (728 * d), 0.02, root.max-zoom);
        root.cx = 0.5;
        root.cy = 0.5;
        root.settle();
    }
    function resized() {
        if root.distance > 0 {
            root.view-from(root.distance);
        } else {
            root.settle();
        }
    }
    changed width => { root.resized(); }
    changed height => { root.resized(); }
    // A wall behind the print when it is smaller than the view.
    background: root.distance > 0 && root.zoom < 1 ? (Theme.dark ? #2b2a28 : #e4e0d8) : transparent;
    if root.distance > 0 && root.zoom < 1: Rectangle {
        x: root.img-x;
        y: root.img-y;
        width: root.img-w;
        height: root.img-h;
        background: #000000;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000060;
    }

    Image {
        source: root.base;
        x: root.img-x;
        y: root.img-y;
        width: root.img-w;
        height: root.img-h;
        image-fit: fill;
        opacity: root.dim;
    }
    if root.has-detail: Image {
        source: root.detail;
        x: root.img-x + root.detail-uv[0] * root.img-w;
        y: root.img-y + root.detail-uv[1] * root.img-h;
        width: (root.detail-uv[2] - root.detail-uv[0]) * root.img-w;
        height: (root.detail-uv[3] - root.detail-uv[1]) * root.img-h;
        image-fit: fill;
        opacity: root.dim;
    }
    // Every tile that shows the chosen photo.
    for m in root.marks: Rectangle {
        // The clicked tile gets a bigger frame than the others.
        property <length> pad: m.current ? 5px : 2px;
        x: root.img-x + m.u * root.img-w - self.pad;
        y: root.img-y + m.v * root.img-h - self.pad;
        width: m.w * root.img-w + 2 * self.pad;
        height: m.h * root.img-h + 2 * self.pad;
        border-width: m.current ? 3px : 2px;
        border-color: #ffffff;
        Rectangle {
            x: parent.border-width;
            y: parent.border-width;
            width: parent.width - 2 * parent.border-width;
            height: parent.height - 2 * parent.border-width;
            border-width: m.current ? 2px : 1px;
            border-color: #000000c0;
        }
        Rectangle {
            x: -2px;
            y: -2px;
            width: parent.width + 4px;
            height: parent.height + 4px;
            visible: m.current;
            border-width: 2px;
            border-color: #000000c0;
        }
    }
    // A single click waits a moment, so a double-click only zooms.
    click-timer := Timer {
        interval: 280ms;
        running: false;
        triggered => {
            self.running = false;
            root.card-right = (root.img-x + root.click-u * root.img-w) < root.width / 2;
            root.tile-clicked(root.click-u, root.click-v);
        }
    }
    ta := TouchArea {
        mouse-cursor: self.pressed && root.zoom > 1.001 ? MouseCursor.grabbing : root.zoom > 1.001 ? MouseCursor.grab : MouseCursor.crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.primary-press = e.button == PointerEventButton.left;
                root.press-cx = root.cx;
                root.press-cy = root.cy;
                if e.button == PointerEventButton.right && root.img-w > 0px && root.img-h > 0px {
                    click-timer.running = false;
                    root.card-right = self.mouse-x < root.width / 2;
                    root.tile-inspect((self.mouse-x - root.img-x) / root.img-w, (self.mouse-y - root.img-y) / root.img-h);
                }
            }
        }
        moved => {
            if root.primary-press && root.img-w > 0px && root.img-h > 0px {
                root.cx = root.press-cx - (self.mouse-x - self.pressed-x) / root.img-w;
                root.cy = root.press-cy - (self.mouse-y - self.pressed-y) / root.img-h;
                root.settle();
            }
        }
        changed mouse-x => { if root.img-w > 0px && root.img-h > 0px { root.hover((self.mouse-x - root.img-x) / root.img-w, (self.mouse-y - root.img-y) / root.img-h); } }
        changed mouse-y => { if root.img-w > 0px && root.img-h > 0px { root.hover((self.mouse-x - root.img-x) / root.img-w, (self.mouse-y - root.img-y) / root.img-h); } }
        scroll-event(e) => {
            if e.delta-y == 0 {
                return reject;
            }
            root.zoom-at(Math.pow(1.004, clamp(e.delta-y / 1px, -120, 120)), self.mouse-x, self.mouse-y);
            accept
        }
        clicked => {
            if root.primary-press && root.img-w > 0px && root.img-h > 0px && abs(self.mouse-x - self.pressed-x) < 4px && abs(self.mouse-y - self.pressed-y) < 4px {
                root.click-u = (self.mouse-x - root.img-x) / root.img-w;
                root.click-v = (self.mouse-y - root.img-y) / root.img-h;
                click-timer.running = false;
                click-timer.running = true;
            }
        }
        double-clicked => {
            click-timer.running = false;
            if root.zoom >= root.max-zoom * 0.99 {
                root.fit();
            } else {
                root.zoom-at(3, self.mouse-x, self.mouse-y);
            }
        }
    }

    // Name of the photo under the mouse.
    if root.zoom > 1.001 && ta.has-hover && root.hover-label != "": Rectangle {
        x: 10px;
        y: root.height - self.height - 10px;
        width: name.preferred-width + 20px;
        height: 30px;
        border-radius: 7px;
        background: #000000b0;
        name := Text { text: root.hover-label; color: #ffffff; font-size: 12px; }
    }
    if root.zoom <= 1.001 && root.distance == 0 && !root.info.open: Rectangle {
        x: 10px;
        y: root.height - self.height - 10px;
        width: help.preferred-width + 20px;
        height: 26px;
        border-radius: 7px;
        background: #00000080;
        help := Text { text: "Click a tile to swap its photo. Right-click for details. Scroll to zoom."; color: #ffffff; font-size: 12px; }
    }
    // The photo of the clicked tile.
    if root.info.open: Rectangle {
        x: root.card-right ? root.width - self.width - 10px : 10px;
        // Below the "View from" bar.
        y: root.artwork-mm > 0 ? 50px : 10px;
        width: 300px;
        height: min(card.preferred-height, root.height - self.y - 50px);
        border-radius: 10px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000050;
        clip: true;
        // Clicks on the card must not reach the preview below.
        TouchArea { }
        card := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.info.name; font-size: 14px; font-weight: 700; color: Theme.fg; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                OverlayButton { text: "×"; tip: "Close."; clicked => { root.close-info(); } }
            }
            Rectangle {
                height: 170px;
                border-radius: 6px;
                background: Theme.bg;
                Image { source: root.info.picture; width: parent.width; height: parent.height; image-fit: contain; }
            }
            Text { text: root.info.date; color: Theme.fg; font-size: 12px; }
            Text { text: root.info.uses; color: Theme.muted; font-size: 12px; }
            Text { text: root.info.place; color: Theme.fg; font-size: 12px; font-weight: 600; }
            Text { text: root.info.distance; color: Theme.muted; font-size: 12px; }
            Text { text: root.info.folder; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 6px;
                alignment: start;
                OverlayButton { text: "Open photo"; tip: "Open the original photo in your photo viewer."; enabled: root.info.has-file; clicked => { root.open-photo(); } }
                OverlayButton { text: "Show folder"; tip: "Open the folder that has this photo."; enabled: root.info.has-file; clicked => { root.show-folder(); } }
                if root.info.more: OverlayButton { text: "Next tile"; tip: "Go to the next tile that shows this photo."; clicked => { root.next-use(); } }
            }
        }
    }
    // View from 1 m, 3 m, 5 m.
    if root.artwork-mm > 0: VerticalLayout {
        x: 10px;
        y: 10px;
        width: root.width - 20px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Rectangle {
                width: vf.preferred-width + 20px;
                height: 30px;
                border-radius: 7px;
                background: #000000b0;
                vf := Text { text: "View from"; color: #ffffff; font-size: 12px; }
            }
            for d[i] in [1, 3, 5]: OverlayButton {
                text: d + " m";
                tip: "See the mosaic as a person " + d + " m away sees it. The preview then shows about what your eyes see at one time.";
                active: root.distance == d;
                clicked => { root.view-from(d); }
            }
        }
        if root.distance > 0: HorizontalLayout {
            alignment: start;
            property <int> soft: root.distance == 1 ? root.soft-tiles[0] : root.distance == 3 ? root.soft-tiles[1] : root.soft-tiles[2];
            Rectangle {
                border-radius: 7px;
                height: 30px;
                width: soft-text.preferred-width + 20px;
                background: soft > 0 ? Theme.coral : #000000b0;
                soft-text := Text {
                    text: soft > 0
                        ? (soft == 1 ? "1 tile looks soft from " + root.distance + " m because its photo is too small." : soft + " tiles look soft from " + root.distance + " m because their photos are too small.")
                        : "From " + root.distance + " m all tiles look sharp.";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: soft > 0 ? 600 : 400;
                }
            }
        }
    }
    HorizontalLayout {
        x: root.width - self.preferred-width - 10px;
        y: root.height - 40px;
        height: 30px;
        spacing: 6px;
        if root.sharpening: Rectangle {
            width: sharp.preferred-width + 20px;
            border-radius: 7px;
            background: #000000b0;
            sharp := Text { text: "Loading sharp photos…"; color: #ffffff; font-size: 12px; }
        }
        OverlayButton { text: "−"; tip: "Zoom out."; enabled: root.zoom > 1.001; clicked => { root.zoom-at(1 / 1.6, root.width / 2, root.height / 2); } }
        OverlayButton { text: round(root.zoom * 100) + "%"; tip: "Show the full mosaic again."; enabled: root.zoom > 1.001 || root.distance > 0; clicked => { root.fit(); } }
        OverlayButton { text: "+"; tip: "Zoom in. The app then loads the sharp photos."; enabled: root.zoom < root.max-zoom; clicked => { root.zoom-at(1.6, root.width / 2, root.height / 2); } }
    }
}

export component AppWindow inherits Window {
    title: "MosaiCxM";
    preferred-width: 1280px;
    preferred-height: 840px;
    min-width: 960px;
    min-height: 640px;
    icon: @image-url("icon.png");
    background: Theme.bg;

    private property <length> steps-width: 360px;
    // Leave at least 420px for the right side and 8px for the divider.
    private property <length> max-steps-width: max(360px, min(root.width * 0.6, root.width - 420px - 8px));
    changed width => {
        root.steps-width = clamp(root.steps-width, 360px, root.max-steps-width);
    }

    // ----- which step is open, and what the big area on the right shows
    in-out property <int> open-step: 1;
    in-out property <int> main-view: 0; // 0 preview, 1 motif suggestions, 2 info text, 3 statistics, 4 folder check, 5 help
    in-out property <string> info-title;
    in-out property <string> info-text;
    in-out property <string> notice; // error or important message shown above the preview

    // ----- 1 Photos
    in-out property <[FolderRow]> folders;
    in-out property <[CollectionRow]> collections;
    in-out property <string> photos-summary: "No photos yet";
    in-out property <int> photo-count: 0;
    in-out property <int> skipped-count: 0;
    in-out property <bool> show-collections: false;
    in-out property <int> people-filter: 0;
    in-out property <int> colour-filter: 0;
    in-out property <bool> skip-documents: false;
    in-out property <bool> show-extra-filters: false;
    in-out property <string> date-from;
    in-out property <string> date-to;
    in-out property <string> camera-filter;
    in-out property <string> lens-filter;
    in-out property <[string]> must-include-names;
    private property <bool> show-model-setup: false;
    in-out property <int> model-provider: 0;
    in-out property <string> model-endpoint: "http://localhost:11434/v1";
    in-out property <string> model-name: "gemma3:4b";
    in-out property <string> model-api-key;
    in-out property <bool> model-active: false;
    in-out property <string> model-status: "Saved AI results are reused. Other photos use offline checks. No images are sent.";
    // Folder check: shown after a folder is picked, before it is added.
    in-out property <string> check-folder;
    in-out property <string> check-summary;
    in-out property <int> check-count: 0;
    in-out property <bool> check-done: false;
    in-out property <[image]> check-thumbs;

    // ----- 2 Picture
    in-out property <string> motif-path;
    in-out property <string> motif-name;
    in-out property <image> motif-image;
    in-out property <float> motif-aspect: 0; // width / height of the chosen picture, 0 = none
    in-out property <string> suggest-folder;
    in-out property <int> suggest-from-library: 30;
    in-out property <[SuggestionRow]> suggestions;
    in-out property <string> suggest-report;

    // ----- 3 Size & style
    in-out property <string> width-mm: "1000";
    in-out property <string> height-mm: "750";
    in-out property <string> tile-mm: "15";
    in-out property <bool> use-grid: false;
    in-out property <int> cols: 60;
    in-out property <int> rows: 45;
    in-out property <int> style-index: 1;
    in-out property <string> grid-info;
    in-out property <string> size-summary;
    in-out property <bool> size-advanced: false;
    in-out property <bool> unlimited-reuse: false;
    in-out property <int> max-reuse: 3;
    in-out property <float> repeat-penalty: 0;
    in-out property <int> repeat-radius: 2;
    in-out property <float> usage-penalty: 0;
    in-out property <bool> crop-offsets: false;
    in-out property <bool> face-crop: true;
    in-out property <int> seed: 1;
    in-out property <float> color-correction: 0;
    in-out property <float> motif-blend: 0;
    in-out property <string> hidden-message;
    in-out property <float> message-strength: 0.5;
    in-out property <int> message-tone: 0; // auto, light, dark
    in-out property <int> shape-index: 0; // 0 rectangle, 1-5 built-in, 6 from file
    in-out property <string> shape-file;
    in-out property <string> shape-file-name;
    in-out property <bool> shape-invert: false;
    in-out property <int> shape-background-index: 0; // white, black, grey
    in-out property <float> shape-threshold: 0.5;

    // ----- preview
    in-out property <image> preview-image;
    in-out property <bool> has-preview: false;
    in-out property <bool> preview-stale: false;
    in-out property <int> settings-revision: 0;
    in-out property <float> preview-zoom: 1;
    in-out property <float> preview-cx: 0.5;
    in-out property <float> preview-cy: 0.5;
    in-out property <float> preview-distance: 0;
    in-out property <float> preview-artwork-mm: 0;
    in-out property <[int]> preview-soft-tiles: [0, 0, 0];
    in-out property <float> preview-max-zoom: 8;
    in-out property <image> preview-detail;
    in-out property <bool> preview-has-detail: false;
    in-out property <[float]> preview-detail-uv: [0, 0, 1, 1];
    in-out property <bool> preview-sharpening: false;
    in-out property <string> preview-hover-label;
    // "Find my photo": the clicked tile's photo, and outlines on its tiles.
    in-out property <TileInfo> tile-info;
    in-out property <[TileMark]> tile-marks;
    in-out property <float> preview-goto-u;
    in-out property <float> preview-goto-v;
    in-out property <int> preview-goto-n;
    in-out property <string> chip-photos;
    in-out property <string> chip-distance;
    in-out property <string> chip-repeats;
    in-out property <string> chip-soft;
    in-out property <string> match-report;
    in-out property <string> project-name: "New mosaic";

    // ----- 4 Export
    in-out property <int> export-kind: 1; // 0 image file, 1 print pages (PDF)
    in-out property <int> raster-format-index: 0;
    in-out property <string> export-dpi: "300";
    in property <[string]> paper-formats;
    in-out property <int> paper-index: 1;
    in-out property <string> custom-w: "600";
    in-out property <string> custom-h: "900";
    in-out property <bool> auto-orientation: true;
    in-out property <bool> landscape: false;
    in-out property <string> margin-mm: "6";
    in-out property <string> overlap-mm: "10";
    in-out property <string> pdf-dpi: "300";
    in-out property <bool> marks: true;
    in-out property <bool> save-manifest: true;
    in-out property <bool> save-photo-index: true;
    in-out property <bool> export-advanced: false;
    in-out property <string> export-summary;
    in-out property <string> export-report;

    // ----- 5 Statistics
    in-out property <bool> has-stats: false;
    in-out property <string> stats-summary;
    in-out property <[Figure]> stat-figures;
    in-out property <[Chart]> stat-charts-left;
    in-out property <[Chart]> stat-charts-right;
    in-out property <string> stats-note;

    // ----- Help (header "Help" button). Screenshots are in ui/help/.
    in-out property <int> help-topic: 0;
    out property <[HelpTopic]> help-topics: [
        {
            title: "Start here",
            tint: Theme.neutral,
            picture: @image-url("help/start.jpg"),
            intro: "MosaiCxM makes one big picture from many small photos. Each small photo is a tile. Do the steps on the left from top to bottom. The preview on the right shows your mosaic.",
            steps: [
                "In step 1, add the folders with your photos.",
                "In step 2, choose the picture that the mosaic copies.",
                "In step 3, set the size of the mosaic and of the tiles.",
                "Click Make preview. Wait until the mosaic shows on the right.",
                "In step 4, export the mosaic as an image file or as pages to print.",
            ],
            notes: [
                "Point at a control and wait a moment. A tooltip tells you what the control does. A small ? next to a name shows that it has a tooltip.",
                "The app saves your work automatically. When you start the app again, it opens your last mosaic.",
                "To look closer at the preview, scroll or double-click it. Drag it to move. Click the percentage to see the full mosaic again.",
                "Click a tile in the preview to swap its photo. Right-click a tile to see its photo details.",
                "To see the mosaic as people see it on the wall, click View from 1 m, 3 m or 5 m above the preview. If a red line shows that tiles look soft, make the tiles smaller.",
                "To keep a mosaic as a file, click Save as…. To use it again, click Open….",
                "When a new version of the app is available, a blue bar shows above the preview. Click Download to get it. To check now, click Help, then Check for updates.",
                "When you change a setting, the preview shows \"Settings changed since this preview\". Click Update preview to see the change.",
            ],
        },
        {
            title: "1  Photos",
            tint: Theme.teal,
            picture: @image-url("help/photos.png"),
            intro: "Your photos become the tiles of the mosaic. More photos give a better mosaic. The app only reads your photos. It does not change, move or delete them.",
            steps: [
                "Click + Add folder.",
                "Select a folder with your photos. The app also uses the photos in its subfolders.",
                "Look at the sample photos on the right. If they are the correct photos, click Use this folder.",
                "Wait until the scan is done. The status bar then shows a green tick and the number of photos.",
            ],
            notes: [
                "The app can read JPEG, PNG, WebP and TIFF files.",
                "Each time the app starts, it checks the folders again. It adds new photos and removes deleted photos.",
                "The scan also finds faces in your photos, so the tiles do not cut off heads. After an update of the app, the first scan can take longer.",
                "If a folder has a yellow box, the app cannot find the folder. Connect the drive again, or click Find it… and select the new location.",
                "If the app skips some files, click why? to see the reason for each file.",
                "Click Remove to stop using a folder. This does not delete your photos.",
                "If you have more than one collection, click Choose collections to select the collections to use.",
            ],
        },
        {
            title: "2  Picture",
            tint: Theme.coral,
            picture: @image-url("help/picture.jpg"),
            intro: "The picture is the image that your mosaic copies. From near, people see your photos. From far away, they see the picture.",
            steps: [
                "Click Choose picture….",
                "Select an image file.",
                "Look at the picture in step 2. The app turns the mosaic to portrait or landscape to match the picture.",
            ],
            notes: [
                "Faces, animals and bold shapes give the best result. Very small details do not show in a mosaic.",
                "Pictures with strong contrast and large areas of colour are easy to see from far away.",
                "If you do not know which picture to use, click Help me choose. Select a folder of pictures to test, then click Find good pictures.",
                "The app gives each picture a score. The score shows how well your photos can copy the picture. It does not show if a picture is beautiful.",
                "Click Use next to a picture to select it.",
            ],
        },
        {
            title: "3  Size & style",
            tint: Theme.amber,
            picture: @image-url("help/size.png"),
            intro: "This step sets the size of the mosaic, the size of each tile, and how the app selects the photos.",
            steps: [
                "Type the width and the height of the mosaic in millimetres. To change between portrait and landscape, click the arrow button.",
                "Type the tile size in millimetres.",
                "If you do not want a rectangle, select a shape.",
                "Select a style: Sharp, Balanced or Varied.",
                "Click Make preview.",
            ],
            notes: [
                "The line below the shape shows the number of tiles and the best distance to look at the mosaic from.",
                "Small tiles show more detail, but you need more photos. If the app shows \"Not enough photos\", use bigger tiles or add more photos.",
                "Big tiles need photos with many pixels. If a photo has too few pixels for its tile, the tile looks soft from near. The chip \"soft up close\" below the preview and the Export step tell you how many tiles look soft from 1 m.",
                "If the picture and the mosaic have different shapes, the app cuts off a part of the picture. The same line tells you how much.",
                "Sharp matches the colours best and is the fastest. Balanced also follows edges. Varied uses the most different photos.",
                "To hide a word, a name or a date in the mosaic, type it in Hidden message. Type | to start a new line. Up close, people see only photos. From far away, they can read the text. If the letters are too small, the line below the settings tells you.",
                "Advanced has more settings, for example Colour correction. Point at each setting to read what it does.",
            ],
        },
        {
            title: "4  Export",
            tint: Theme.violet,
            picture: @image-url("help/export.jpg"),
            intro: "Export saves the full-size mosaic. Make a preview first. The export uses the same photos as the preview.",
            steps: [
                "Select Image file or Print pages (PDF).",
                "For an image file, select the format and the print quality.",
                "For print pages, select the paper size. The app chooses the orientation with fewer sheets.",
                "Click Export image… or Export PDF…, and select where to save the file.",
                "Wait until the status bar shows that the export is done.",
            ],
            notes: [
                "Use an image file for a print shop. A BigTIFF file can be any size.",
                "300 DPI gives a sharp print. A big mosaic at 300 DPI makes a very big file.",
                "The box above the export button shows the size of the file or the number of pages.",
                "The app can also save a list of the photos that it used (CSV). A spreadsheet program can open this list.",
                "The app can also save a photo index (PDF). Print it and put it next to the mosaic. Then people can find their photos.",
                "Each export also saves the statistics as a .stats.json file next to the mosaic.",
            ],
        },
        {
            title: "5  Statistics",
            tint: Theme.blue,
            picture: @image-url("help/statistics.png"),
            intro: "Statistics show which photos your mosaic uses and how often. They also show the camera settings of the photos, if the photo files have this data.",
            steps: [
                "Make a preview.",
                "Open step 5 and click Show statistics.",
                "To keep the numbers in a file, click Save as JSON….",
            ],
            notes: [
                "The camera settings come from the EXIF data in the photo files. Some photos do not have EXIF data.",
                "Each export also saves the statistics next to the mosaic.",
            ],
        },
        {
            title: "Print and glue the pages",
            tint: Theme.violet,
            picture: @image-url("help/print.jpg"),
            intro: "The PDF has a map on the first page, which is always A4. The other pages use your chosen paper size and are the parts of the mosaic. Each page has a name, for example A1.",
            steps: [
                "Print all pages at 100% (Actual size). Turn off Fit to page and borderless printing.",
                "Measure the square on the first page. It must be 50 × 50 mm. If it is not, correct the printer settings.",
                "Find the name on each page. The letter is the row. The number is the column. A1 is the top-left page.",
                "Cut the left edge of each page, but not the pages in column 1. Cut along the crop marks.",
                "Cut the top edge of each page, but not the pages in row A.",
                "Put each cut page on its left and upper neighbour. Align the cut edge with the marks, then glue it.",
                "At the end, cut the outer edges along the crop marks.",
            ],
            notes: [
                "Each page shows the names of the pages next to it.",
                "Grey pages on the map are empty. The app does not print them.",
                "Glue overlap in Advanced sets how much the pages overlap.",
            ],
        },
        {
            title: "Find a photo",
            tint: Theme.blue,
            picture: @image-url("help/find.jpg"),
            intro: "You can see the original photo of each tile. The photo index helps people find their photos on the printed mosaic.",
            steps: [
                "Right-click a tile in the preview. A box shows the photo, its date and its folder.",
                "White frames show all the tiles with this photo. A bigger frame shows the tile that you clicked.",
                "Click Next tile to go to the next tile with this photo.",
                "Click Open photo to open the original photo. Click Show folder to open its folder.",
                "To close the box, click ×.",
            ],
            notes: [
                "Double-click zooms in. A single click swaps the photo; right-click shows its details.",
                "In step 4, tick Also save a photo index to find each photo (PDF). The app saves the index next to the mosaic.",
                "The first page of the index is a map. The map divides the mosaic into areas. The letter is the row of areas. The number is the column of areas. A1 is at the top left.",
                "The other pages show each photo with its date and its area, row and column. They also show the distance from the left edge and from the top edge.",
                "The date comes from the photo file. If a photo has no date, it is at the end of the list.",
            ],
        },
        {
            title: "Problems",
            tint: Theme.coral,
            picture: @image-url("help/problems.jpg"),
            intro: "Find your problem below. Each line gives the problem and then what to do.",
            steps: [],
            notes: [
                "The export button is grey: make a preview first.",
                "The preview shows \"Settings changed since this preview\": click Update preview.",
                "\"Not enough photos\": use bigger tiles or add more photos. Or, in Advanced, tick Use each photo as often as needed.",
                "The mosaic does not look like the picture: use smaller tiles, or increase Colour correction in Advanced. Look at the preview from further away.",
                "The app works for a long time: big mosaics need more time. The wheel in the status bar turns while the app works. To stop, click Cancel.",
                "The printed pages do not fit together: print at 100% (Actual size), then measure the 50 mm square.",
                "A folder shows \"Folder not found\": connect the drive again, or click Find it….",
                "Heads are cut off in the tiles: in Advanced, tick Keep faces in frame. If the app is still scanning, wait until the scan is done, then click Update preview.",
            ],
        },
    ];

    // ----- update check (Help menu, and the blue bar above the preview)
    in-out property <string> app-version; // "" for a development build
    in-out property <bool> check-updates-at-start: true;
    in-out property <bool> update-checking: false;
    in-out property <string> update-message; // "" hides the bar
    in-out property <string> update-version; // newer version to download, "" when there is none
    callback check-updates();
    callback check-at-start-changed(bool);
    callback update-download();
    callback update-ignore();

    // ----- job status
    in-out property <bool> busy: false;
    in-out property <string> status: "Ready";
    in-out property <float> progress: 0;
    in-out property <bool> progress-known: false;
    // Last photo scan finished with photos found and no folder missing.
    in-out property <bool> photos-indexed: false;

    callback add-folder();
    callback confirm-folder();
    callback cancel-folder-check();
    callback remove-folder(int);
    callback find-folder(int);
    callback toggle-collection(int, bool);
    callback show-skipped();
    callback add-must-include();
    callback remove-must-include(int);
    callback clear-must-include();
    callback model-provider-changed();
    callback model-config-changed();
    callback enable-model();
    callback disable-model();
    callback test-model();

    callback browse-motif();
    callback swap-size();
    callback browse-shape() -> bool;
    callback browse-suggest-folder();
    callback suggest();
    callback use-suggestion(int);

    callback style-changed(int);
    callback settings-changed();
    callback generate();
    callback new-selection();
    callback save-project();
    callback open-project();
    callback preview-view-changed(float, float, float, length, length, length, length);
    callback preview-hover(float, float);
    callback preview-tile-clicked(float, float);
    callback preview-tile-inspect(float, float);
    callback tile-open-photo();
    callback tile-show-folder();
    callback tile-next-use();
    callback tile-close();

    callback export-settings-changed();
    callback export();
    callback show-stats();
    callback save-stats-json();
    callback cancel();

    // Refresh after editing stops; keep the first preview an explicit action.
    function changed() {
        root.settings-revision += 1;
        root.preview-stale = root.has-preview;
        root.settings-changed();
        preview-update.running = false;
        preview-update.running = root.has-preview;
    }

    preview-update := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            if !root.busy {
                self.running = false;
                if root.has-preview && root.preview-stale {
                    root.generate();
                }
            }
        }
    }

    VerticalLayout {
        // ===================== header band
        Rectangle {
            height: 52px;
            background: Theme.ink;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    for c in [Theme.teal, Theme.coral, Theme.amber, Theme.violet]: Rectangle {
                        width: 10px;
                        height: 10px;
                        y: 21px;
                        border-radius: 2px;
                        background: c;
                    }
                }
                Text { text: "MosaiCxM"; horizontal-stretch: 0; color: #ffffff; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                Text { text: root.project-name; color: #b8c0d0; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                for item[i] in ["Open…", "Save as…", "Help ▾"]: Rectangle {
                    width: t.preferred-width + 24px;
                    height: 32px;
                    y: 10px;
                    border-radius: 6px;
                    background: ta.has-hover ? #ffffff22 : transparent;
                    t := Text { text: item; color: (i == 1 && !root.has-preview) ? #6d7586 : #e9edf5; font-size: 13px; font-weight: i == 2 ? 700 : 400; }
                    ta := TouchArea {
                        enabled: i == 2 || (!root.busy && (i == 0 || root.has-preview));
                        mouse-cursor: pointer;
                        clicked => {
                            if (i == 0) { root.open-project(); }
                            else if (i == 1) { root.save-project(); }
                            else { help-menu.show(); }
                        }
                    }
                }
            }

            help-menu := PopupWindow {
                x: parent.width - self.width - 12px;
                y: 46px;
                width: 260px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000040;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        MenuRow { text: "Help topics"; clicked => { root.main-view = 5; } }
                        MenuRow {
                            text: root.update-checking ? "Checking for updates…" : "Check for updates";
                            enabled: !root.update-checking;
                            clicked => { root.check-updates(); }
                        }
                        MenuRow {
                            text: "Check for updates at start";
                            mark: root.check-updates-at-start ? "✓" : "";
                            clicked => {
                                root.check-updates-at-start = !root.check-updates-at-start;
                                root.check-at-start-changed(root.check-updates-at-start);
                            }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            padding-left: 30px;
                            height: 26px;
                            Text {
                                text: root.app-version == "" ? "MosaiCxM (development build)" : "MosaiCxM " + root.app-version;
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // ===================== steps
            steps-panel := Rectangle {
                width: root.steps-width;
                background: Theme.surface;
                steps-scroll := ScrollView {
                    VerticalLayout {
                        width: steps-scroll.visible-width;
                        padding: 14px;
                        spacing: 10px;
                        alignment: start;

                        // ---------- 1 Photos (teal)
                        photos-card := StepCard {
                            open: root.open-step == 1;
                            tint: Theme.teal;
                            soft: Theme.teal-soft;
                            StepHeader {
                                number: "1";
                                title: "Photos";
                                summary: root.photos-summary;
                                done: root.photo-count > 0;
                                tint: Theme.teal;
                                tip: "Add the folders with your photos. The photos become the small tiles of the mosaic.";
                                clicked => { root.open-step = 1; }
                            }
                            if root.open-step == 1: VerticalLayout {
                                spacing: 8px;
                                for f[i] in root.folders: Rectangle {
                                    border-radius: 6px;
                                    background: f.missing ? Theme.amber-soft : transparent;
                                    border-width: f.missing ? 1px : 0px;
                                    border-color: Theme.amber;
                                    HorizontalLayout {
                                        padding: f.missing ? 6px : 2px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: f.path; font-size: 12px; color: Theme.fg; overflow: elide; }
                                            if f.missing: Text { text: "Folder not found. Was it moved or is the drive unplugged?"; font-size: 11px; color: Theme.fg; wrap: word-wrap; }
                                        }
                                        if f.missing: LinkButton {
                                            text: "Find it…";
                                            tint: Theme.fg;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            enabled: !root.busy;
                                            clicked => { root.find-folder(i); }
                                        }
                                        LinkButton {
                                            text: "Remove";
                                            vertical-alignment: center;
                                            enabled: !root.busy;
                                            clicked => { root.remove-folder(i); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Tipped {
                                        tip: "Select a folder with your photos. The app also uses the photos in its subfolders. The app only reads your photos. It does not change them.";
                                        ColorButton {
                                            text: "+ Add folder";
                                            tint: Theme.teal;
                                            enabled: !root.busy;
                                            clicked => { root.add-folder(); }
                                        }
                                    }
                                    if root.skipped-count > 0: LinkButton {
                                        text: root.skipped-count + " files skipped · why?";
                                        vertical-alignment: center;
                                        clicked => { root.show-skipped(); }
                                    }
                                }
                                if root.collections.length > 1: LinkButton {
                                    text: (root.show-collections ? "▾" : "▸") + " Choose collections";
                                    clicked => { root.show-collections = !root.show-collections; }
                                }
                                if root.collections.length > 1 && root.show-collections: VerticalLayout {
                                    for c[i] in root.collections: CheckBox {
                                        text: c.name + "  (" + c.summary + ")";
                                        checked: c.selected;
                                        toggled => {
                                            root.toggle-collection(i, self.checked);
                                            root.changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "People";
                                    tip: "People / portraits uses photos with a detected face covering at least 2% of the picture. No people excludes photos with detected faces. Detection can miss faces.";
                                    ComboBox {
                                        model: ["All photos", "People / portraits", "No people"];
                                        current-index <=> root.people-filter;
                                        selected => { root.changed(); }
                                    }
                                }
                                Field {
                                    label: "Photo colours";
                                    tip: "Use all photos, just colour photos, or just photos that are already black and white. Filters combine with the People setting.";
                                    ComboBox {
                                        model: ["All colours", "Colour only", "Black and white only"];
                                        current-index <=> root.colour-filter;
                                        selected => { root.changed(); }
                                    }
                                }
                                Tipped {
                                    tip: "Skip likely document pages and screenshots. Offline checks inspect the original image for page patterns and faint handwriting. You can also enable a vision model below. Detection is approximate; ordinary photos with incidental signs or writing can still be used.";
                                    CheckBox {
                                        text: "Skip likely documents/screenshots";
                                        checked <=> root.skip-documents;
                                        toggled => { root.changed(); }
                                    }
                                }
                                LinkButton {
                                    text: (root.show-extra-filters ? "▾" : "▸") + " Date, camera & must-include photos"
                                        + (root.must-include-names.length > 0 ? " (" + root.must-include-names.length + ")" : "");
                                    clicked => { root.show-extra-filters = !root.show-extra-filters; }
                                }
                                if root.show-extra-filters: Rectangle {
                                    background: Theme.surface;
                                    border-color: Theme.line;
                                    border-width: 1px;
                                    border-radius: 8px;
                                    min-height: extra-filters-form.preferred-height;
                                    extra-filters-form := VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            StackedField {
                                                horizontal-stretch: 1;
                                                label: "From date";
                                                tip: "Only use photos taken on or after this EXIF date (YYYY, YYYY-MM, or YYYY-MM-DD).";
                                                LineEdit {
                                                    text <=> root.date-from;
                                                    placeholder-text: "e.g. 2023-06";
                                                    enabled: !root.busy;
                                                    edited => { root.changed(); }
                                                }
                                            }
                                            StackedField {
                                                horizontal-stretch: 1;
                                                label: "To date";
                                                tip: "Only use photos taken on or before this EXIF date (YYYY, YYYY-MM, or YYYY-MM-DD).";
                                                LineEdit {
                                                    text <=> root.date-to;
                                                    placeholder-text: "e.g. 2024-12-31";
                                                    enabled: !root.busy;
                                                    edited => { root.changed(); }
                                                }
                                            }
                                        }
                                        StackedField {
                                            label: "Camera contains";
                                            tip: "Match a substring of the EXIF camera make or model (case-insensitive), e.g. Fuji, iPhone, EOS.";
                                            LineEdit {
                                                text <=> root.camera-filter;
                                                placeholder-text: "Any camera";
                                                enabled: !root.busy;
                                                edited => { root.changed(); }
                                            }
                                        }
                                        StackedField {
                                            label: "Lens contains";
                                            tip: "Match a substring of the EXIF lens name (case-insensitive), e.g. 50mm, 24-70.";
                                            LineEdit {
                                                text <=> root.lens-filter;
                                                placeholder-text: "Any lens";
                                                enabled: !root.busy;
                                                edited => { root.changed(); }
                                            }
                                        }
                                        Text { text: "Must-include photos"; color: Theme.fg; font-size: 12px; font-weight: 600; }
                                        Text {
                                            text: "Guaranteed to appear at least once at their best matching tile (must be in your added folders).";
                                            color: Theme.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                            min-height: self.preferred-height;
                                        }
                                        for name[i] in root.must-include-names: HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: name; color: Theme.fg; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            LinkButton {
                                                text: "Remove";
                                                vertical-alignment: center;
                                                enabled: !root.busy;
                                                clicked => { root.remove-must-include(i); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "+ Choose photos…";
                                                enabled: !root.busy;
                                                clicked => { root.add-must-include(); }
                                            }
                                            if root.must-include-names.length > 0: LinkButton {
                                                text: "Clear all";
                                                vertical-alignment: center;
                                                enabled: !root.busy;
                                                clicked => { root.clear-must-include(); }
                                            }
                                        }
                                    }
                                }
                                model-setup-toggle := LinkButton {
                                    text: (root.show-model-setup ? "▾" : "▸") + " AI document filter (optional)";
                                    clicked => { root.show-model-setup = !root.show-model-setup; }
                                }
                                if root.show-model-setup: model-settings := Rectangle {
                                    background: Theme.surface;
                                    border-color: Theme.line;
                                    border-width: 1px;
                                    border-radius: 8px;
                                    min-height: model-form.preferred-height;
                                    model-form := VerticalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: start;
                                        Text { text: "Document detection"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                                        if root.busy: Text {
                                            text: "Settings are available when the current task finishes.";
                                            color: Theme.muted; font-size: 11px; wrap: word-wrap; min-height: self.preferred-height;
                                        }
                                        StackedField {
                                            label: "Provider";
                                            tip: "Connect a vision model you already run, or choose a cloud service. Model checks are optional and start only after you click Enable model checks.";
                                            model-provider-input := ComboBox {
                                                model: ["Ollama", "LM Studio", "vLLM (Linux / server)", "TypeSafe Jev", "OpenAI Decisions"];
                                                current-index <=> root.model-provider;
                                                enabled: !root.busy;
                                                selected => { root.model-provider-changed(); }
                                            }
                                        }
                                        if root.model-provider < 3: StackedField {
                                            label: "API base URL";
                                            tip: "Ollama usually uses http://localhost:11434/v1, LM Studio :1234/v1 and vLLM :8000/v1. Replace localhost with your server address when it runs on another computer.";
                                            LineEdit { text <=> root.model-endpoint; enabled: !root.busy; edited => { root.model-config-changed(); } }
                                        }
                                        StackedField {
                                            label: "Vision model";
                                            tip: "Enter the exact name of a model that accepts images. In LM Studio or vLLM, use the loaded/served model's name.";
                                            LineEdit { text <=> root.model-name; placeholder-text: "Your loaded vision model"; enabled: !root.busy; edited => { root.model-config-changed(); } }
                                        }
                                        StackedField {
                                            label: root.model-provider >= 3 ? "API key" : "Server API key (optional)";
                                            tip: "The key stays in memory for this session. It is never saved in a mosaic or settings file. OpenAI and Jev can also read OPENAI_API_KEY or TYPESAFE_API_KEY from the environment.";
                                            LineEdit { text <=> root.model-api-key; input-type: password; enabled: !root.busy; edited => { root.model-config-changed(); } }
                                        }
                                        Text {
                                            text: root.model-provider >= 3
                                                ? "Sends photo previews to " + (root.model-provider == 3 ? "TypeSafe" : "OpenAI") + ". API charges may apply." + (root.model-provider == 3 ? " Image support is experimental." : "")
                                                : "Sends photo previews to the server above. Use a vision model on a server you trust.";
                                            color: Theme.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                            min-height: self.preferred-height;
                                        }
                                        Text { text: "API keys stay in memory for this session. They are not saved in your mosaic."; color: Theme.muted; font-size: 11px; wrap: word-wrap; min-height: self.preferred-height; }
                                        VerticalLayout {
                                            spacing: 6px;
                                            Button { text: "Test with image…"; enabled: !root.busy; clicked => { root.test-model(); } }
                                            Button {
                                                text: root.model-active ? "Use offline only" : "Enable model checks";
                                                enabled: !root.busy;
                                                clicked => { if root.model-active { root.disable-model(); } else { root.enable-model(); } }
                                            }
                                        }
                                        Rectangle {
                                            background: Theme.bg;
                                            border-radius: 6px;
                                            min-height: model-state.preferred-height;
                                            model-state := VerticalLayout {
                                                padding: 10px;
                                                model-status-text := Text { text: root.model-status; color: Theme.fg; font-size: 11px; wrap: word-wrap; min-height: self.preferred-height; }
                                            }
                                        }
                                        Text { text: "Results survive restarts and updates. Saved results need no tokens. Enable model checks to check new photos."; color: Theme.muted; font-size: 11px; wrap: word-wrap; min-height: self.preferred-height; }
                                    }
                                }
                            }
                        }

                        // ---------- 2 Picture (coral)
                        StepCard {
                            open: root.open-step == 2;
                            tint: Theme.coral;
                            soft: Theme.coral-soft;
                            StepHeader {
                                number: "2";
                                title: "Picture";
                                summary: root.motif-name == "" ? "Not chosen" : root.motif-name;
                                done: root.motif-path != "";
                                tint: Theme.coral;
                                tip: "Choose the picture that your mosaic copies.";
                                clicked => { root.open-step = 2; }
                            }
                            if root.open-step == 2: VerticalLayout {
                                spacing: 8px;
                                if root.motif-path != "": Rectangle {
                                    height: 150px;
                                    border-radius: 8px;
                                    background: Theme.bg;
                                    Image { source: root.motif-image; image-fit: contain; width: parent.width - 8px; height: parent.height - 8px; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Tipped {
                                        tip: "Select the picture that your mosaic copies. Faces, animals and bold shapes give the best result.";
                                        ColorButton {
                                            text: root.motif-path == "" ? "Choose picture…" : "Change picture…";
                                            tint: Theme.coral;
                                            clicked => { root.browse-motif(); }
                                        }
                                    }
                                    Tipped {
                                        tip: "Test some pictures and see which ones your photos can copy best.";
                                        LinkButton {
                                            text: "Help me choose";
                                            tint: Theme.coral;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            clicked => { root.main-view = 1; }
                                        }
                                    }
                                }
                            }
                        }

                        // ---------- 3 Size & style (amber)
                        StepCard {
                            open: root.open-step == 3;
                            tint: Theme.amber;
                            soft: Theme.amber-soft;
                            StepHeader {
                                number: "3";
                                title: "Size & style";
                                summary: root.size-summary;
                                done: root.has-preview && !root.preview-stale;
                                tint: Theme.amber;
                                tip: "Set the size of the mosaic, the size of the tiles and the style.";
                                clicked => { root.open-step = 3; }
                            }
                            if root.open-step == 3: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        horizontal-stretch: 1;
                                        Field { label: "Width (mm)"; tip: "The width of the finished mosaic in millimetres. 1000 mm is 1 metre."; LineEdit { accessible-label: "Mosaic width (mm)"; min-width: 80px; text <=> root.width-mm; edited => { root.changed(); } } }
                                        Field { label: "Height (mm)"; tip: "The height of the finished mosaic in millimetres."; LineEdit { accessible-label: "Mosaic height (mm)"; min-width: 80px; text <=> root.height-mm; edited => { root.changed(); } } }
                                    }
                                    SwapButton {
                                        tooltip-text: "Swap the width and the height. This changes the mosaic from portrait to landscape, or from landscape to portrait.";
                                        clicked => {
                                            root.swap-size();
                                            root.changed();
                                        }
                                    }
                                }
                                if !root.use-grid: Field { label: "Tile size (mm)"; tip: "The size of each small photo. Small tiles show more detail, but you need more photos. Big tiles look good from far away."; LineEdit { text <=> root.tile-mm; edited => { root.changed(); } } }
                                Field {
                                    label: "Shape";
                                    tip: "The outline of the mosaic. Tiles go only inside the shape.";
                                    ComboBox {
                                        model: ["Rectangle", "Ellipse", "Heart", "Hexagon", "Diamond", "Star", "From file (SVG, PNG, JPG…)"];
                                        current-index <=> root.shape-index;
                                        selected => {
                                            if root.shape-index == 6 && root.shape-file == "" {
                                                if root.browse-shape() { root.changed(); }
                                            } else {
                                                root.changed();
                                            }
                                        }
                                    }
                                }
                                if root.shape-index == 6: Field {
                                    label: "Shape file";
                                    tip: "SVG: the drawn parts make the shape. PNG with transparency: the solid parts make the shape. Other pictures: the dark parts make the shape.";
                                    Text { text: root.shape-file-name == "" ? "None chosen" : root.shape-file-name; color: Theme.fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Button { text: "Choose…"; clicked => { if root.browse-shape() { root.changed(); } } }
                                }
                                if root.shape-index == 6: TipCheck { text: "Swap inside and outside"; tip: "Put the tiles outside the shape, not inside it."; checked <=> root.shape-invert; toggled => { root.changed(); } }
                                if root.shape-index > 0: Field {
                                    label: "Outside the shape";
                                    tip: "The colour of the area outside the shape.";
                                    ComboBox { model: ["White", "Black", "Light grey"]; current-index <=> root.shape-background-index; selected => { root.changed(); } }
                                }
                                Field {
                                    label: "Hidden message";
                                    tip: "Write a word, a name or a date into the mosaic. The app puts lighter or darker photos where the letters are. Up close you see only photos. From far away you can read the text. Type | to start a new line. Leave empty for no message.";
                                    LineEdit { placeholder-text: "e.g. ANNA & TOM | 2026"; text <=> root.hidden-message; edited => { root.changed(); } }
                                }
                                if root.hidden-message != "": Field {
                                    label: "How easy to read";
                                    tip: "Higher values make the text easier to read from far away. Lower values hide it better.";
                                    Slider { min-width: 100px; horizontal-stretch: 1; minimum: 0.1; maximum: 1; value <=> root.message-strength; changed => { root.changed(); } }
                                    Text { text: round(root.message-strength * 100) + "%"; min-width: 36px; color: Theme.fg; vertical-alignment: center; }
                                }
                                if root.hidden-message != "": Field {
                                    label: "Letters";
                                    tip: "Auto makes the letters light on a dark picture and dark on a light picture.";
                                    ComboBox { model: ["Auto", "Light", "Dark"]; current-index <=> root.message-tone; selected => { root.changed(); } }
                                }
                                Hint { width: parent.width; text: root.grid-info; }
                                Tipped {
                                    tip: "How the app selects a photo for each tile. Point at each style to read more.";
                                    Label { text: "Style"; font-size: 13px; }
                                    HelpDot { }
                                }
                                Segmented {
                                    options: ["Sharp", "Balanced", "Varied"];
                                    tips: [
                                        "Sharp: the app matches the colour of each tile as closely as possible. This is the fastest style. Each photo is used 5 times or less.",
                                        "Balanced: the app also follows edges and shading in each tile, so outlines look cleaner. Each photo is used 3 times or less.",
                                        "Varied: the app uses as many different photos as possible and prevents repeats near each other. Each photo is used 2 times or less.",
                                    ];
                                    current <=> root.style-index;
                                    tint: Theme.amber;
                                    changed(i) => {
                                        root.style-changed(i);
                                        root.changed();
                                    }
                                }
                                AdvancedPanel {
                                    text: "grid, reuse, colour correction…";
                                    expanded: root.size-advanced;
                                    tint: Theme.amber;
                                    toggled => { root.size-advanced = !root.size-advanced; }
                                    if root.size-advanced: VerticalLayout {
                                        spacing: 6px;
                                        TipCheck { switch: true; text: "Set columns × rows instead of tile size"; tip: "Type the number of tiles across and down. The app then calculates the tile size."; checked <=> root.use-grid; toggled => { root.changed(); } }
                                        if root.use-grid: Field {
                                            label: "Columns × rows";
                                            tip: "The number of tiles across (columns) and down (rows).";
                                            SpinBox { minimum: 1; maximum: 2000; value <=> root.cols; edited => { root.changed(); } }
                                            SpinBox { minimum: 1; maximum: 2000; value <=> root.rows; edited => { root.changed(); } }
                                        }
                                        TipCheck { text: "Use each photo as often as needed"; tip: "Remove the limit on how many times one photo can be used. Use this if you have few photos."; checked <=> root.unlimited-reuse; toggled => { root.changed(); } }
                                        Field { label: "Max uses per photo"; tip: "The maximum number of times that the app can use one photo. The style sets this value. You can change it here."; SpinBox { enabled: !root.unlimited-reuse; minimum: 1; maximum: 10000; value <=> root.max-reuse; edited => { root.changed(); } } }
                                        Field {
                                            label: "Avoid nearby repeats";
                                            tip: "Higher values stop the same photo from showing close to itself. 0 turns this off.";
                                            Slider { minimum: 0; maximum: 30; value <=> root.repeat-penalty; changed => { root.changed(); } }
                                            Text { text: round(root.repeat-penalty); min-width: 28px; color: Theme.fg; vertical-alignment: center; }
                                        }
                                        Field { label: "…within (tiles)"; tip: "The distance in tiles that counts as near for the setting above."; SpinBox { minimum: 1; maximum: 20; value <=> root.repeat-radius; edited => { root.changed(); } } }
                                        Field {
                                            label: "Spread photo use";
                                            tip: "Higher values make the app use more different photos. This works only with the Varied style.";
                                            Slider { enabled: root.style-index == 2; minimum: 0; maximum: 10; value <=> root.usage-penalty; changed => { root.changed(); } }
                                            Text { text: round(root.usage-penalty * 10) / 10; min-width: 28px; color: Theme.fg; vertical-alignment: center; }
                                        }
                                        TipCheck { text: "Try off-centre crops"; tip: "The app also tries to cut each photo away from its centre, if this gives a better match. This is slower."; checked <=> root.crop-offsets; toggled => { root.changed(); } }
                                        TipCheck { text: "Keep faces in frame"; tip: "The app finds faces in your photos when it scans them. It cuts each photo so that the faces stay whole in the tile. Photos without faces keep their top part if they are tall."; checked <=> root.face-crop; toggled => { root.changed(); } }
                                        if root.shape-index > 0: Field {
                                            label: "Edge tiles";
                                            tip: "Tiles on the edge of the shape. A tile is used only if this much of it is inside the shape.";
                                            Slider { minimum: 0.05; maximum: 1; value <=> root.shape-threshold; changed => { root.changed(); } }
                                            Text { text: round(root.shape-threshold * 100) + "% in"; min-width: 48px; color: Theme.fg; vertical-alignment: center; }
                                        }
                                        Field { label: "Shuffle number"; tip: "Change this number to get a different mix of photos with the same settings. The same number always gives the same mosaic."; SpinBox { minimum: 0; maximum: 1000000; value <=> root.seed; edited => { root.changed(); } } }
                                        Field {
                                            label: "Colour correction";
                                            tip: "Moves the colour of each photo near the colour of the picture. Higher values make the picture easier to see. This changes how your photos look.";
                                            Slider { minimum: 0; maximum: 0.5; value <=> root.color-correction; changed => { root.changed(); } }
                                            Text { text: round(root.color-correction * 100) + "%"; min-width: 36px; color: Theme.fg; vertical-alignment: center; }
                                        }
                                        Field {
                                            label: "Blend in picture";
                                            tip: "Mixes the picture over the photos. Higher values make the picture easier to see, but the photos are less clear.";
                                            Slider { minimum: 0; maximum: 0.5; value <=> root.motif-blend; changed => { root.changed(); } }
                                            Text { text: round(root.motif-blend * 100) + "%"; min-width: 36px; color: Theme.fg; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // ---------- 4 Export (violet)
                        StepCard {
                            open: root.open-step == 4;
                            tint: Theme.violet;
                            soft: Theme.violet-soft;
                            StepHeader {
                                number: "4";
                                title: "Export";
                                summary: root.has-preview ? (root.export-kind == 0 ? "Image file" : "Print pages") : "After preview";
                                done: false;
                                tint: Theme.violet;
                                tip: "Save the mosaic as one image file, or as pages to print and glue together.";
                                clicked => {
                                    root.open-step = 4;
                                    root.export-settings-changed();
                                }
                            }
                            if root.open-step == 4: VerticalLayout {
                                spacing: 8px;
                                Segmented {
                                    options: ["Image file", "Print pages (PDF)"];
                                    tips: [
                                        "Save the mosaic as one big image file. Use this for a print shop or to show it on a screen.",
                                        "Save the mosaic as pages in a PDF file. Print the pages at home and glue them together.",
                                    ];
                                    current <=> root.export-kind;
                                    tint: Theme.violet;
                                    changed => { root.export-settings-changed(); }
                                }
                                if root.export-kind == 0: VerticalLayout {
                                    spacing: 6px;
                                    Field { label: "Format"; tip: "BigTIFF can be any size. Use PNG or JPEG only if another program cannot open BigTIFF. JPEG has a maximum size."; ComboBox { model: ["BigTIFF (any size)", "PNG", "JPEG (up to 65,535 px)"]; current-index <=> root.raster-format-index; selected => { root.export-settings-changed(); } } }
                                    Field { label: "Print quality (DPI)"; tip: "Dots per inch. 300 gives a sharp print. Lower values make a smaller file."; LineEdit { text <=> root.export-dpi; edited => { root.export-settings-changed(); } } }
                                }
                                if root.export-kind == 1: VerticalLayout {
                                    spacing: 6px;
                                    Field { label: "Paper"; tip: "The finished paper size in your printer. SELPHY CP sizes exclude the perforated ends."; ComboBox { model: root.paper-formats; current-index <=> root.paper-index; selected => { root.export-settings-changed(); } } }
                                    if root.paper-index == root.paper-formats.length - 1: Field {
                                        label: "Paper W × H (mm)";
                                        tip: "The width and height of your paper in millimetres.";
                                        LineEdit { text <=> root.custom-w; edited => { root.export-settings-changed(); } }
                                        LineEdit { text <=> root.custom-h; edited => { root.export-settings-changed(); } }
                                    }
                                    TipCheck { text: "Choose orientation with fewer pages"; tip: "Compare portrait and landscape with your print settings. Use the orientation that needs fewer sheets."; checked <=> root.auto-orientation; toggled => { root.export-settings-changed(); } }
                                    if !root.auto-orientation: TipCheck { text: "Landscape"; tip: "Turn the pages so that they are wider than they are tall."; checked <=> root.landscape; toggled => { root.export-settings-changed(); } }
                                    AdvancedPanel {
                                        text: "margins, overlap, DPI, marks";
                                        expanded: root.export-advanced;
                                        tint: Theme.violet;
                                        toggled => { root.export-advanced = !root.export-advanced; }
                                        if root.export-advanced: VerticalLayout {
                                            spacing: 6px;
                                            Field { label: "Printer margin (mm)"; tip: "The edge of the paper that your printer cannot print on."; LineEdit { text <=> root.margin-mm; edited => { root.export-settings-changed(); } } }
                                            Field { label: "Glue overlap (mm)"; tip: "Each page shows this much of the next page. You put the pages on top of each other here and glue them."; LineEdit { text <=> root.overlap-mm; edited => { root.export-settings-changed(); } } }
                                            Field { label: "Print quality (DPI)"; tip: "Dots per inch. 300 gives a sharp print. Lower values make a smaller file."; LineEdit { text <=> root.pdf-dpi; edited => { root.export-settings-changed(); } } }
                                            TipCheck { text: "Crop marks, labels and ruler"; tip: "Print lines that show where to cut, a name on each page (A1, A2…) and a ruler to check the size."; checked <=> root.marks; toggled => { root.export-settings-changed(); } }
                                        }
                                    }
                                }
                                if root.export-summary != "" || root.preview-stale: Rectangle {
                                    border-radius: 6px;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: root.preview-stale ? "Settings changed. Export is available after the preview updates." : root.export-summary; font-size: 12px; color: root.preview-stale ? Theme.coral : Theme.fg; wrap: word-wrap; }
                                    }
                                }
                                TipCheck { text: "Also save a list of the photos used (CSV)"; tip: "Save a list of all photos in the mosaic and where each one is. A spreadsheet program can open this file."; checked <=> root.save-manifest; }
                                TipCheck { text: "Also save a separate photo index (PDF)"; tip: "Save a separate A4 guide listing each photo, its date and where it is on the mosaic. The printable mosaic sheets are in the main export PDF."; checked <=> root.save-photo-index; }
                                HorizontalLayout {
                                    alignment: start;
                                    Tipped {
                                        tip: !root.has-preview ? "Make a preview first. The export uses the same photos as the preview."
                                            : root.preview-stale ? "Wait for the preview to update before exporting."
                                            : root.export-kind == 0 ? "Select where to save the image file."
                                            : "Select where to save the PDF. Then print it at 100% (Actual size) with Fit to page turned off. Measure the 50 mm square to check the size.";
                                        ColorButton {
                                            text: root.export-kind == 0 ? "Export image…" : "Export PDF…";
                                            accessible-role: button;
                                            accessible-label: self.text;
                                            accessible-enabled: self.enabled;
                                            tint: Theme.violet;
                                            enabled: !root.busy && root.has-preview && !root.preview-stale;
                                            clicked => { root.export(); }
                                        }
                                    }
                                }
                                if root.export-report != "": Hint { width: parent.width; text: root.export-report; }
                            }
                        }

                        // ---------- 5 Statistics (blue)
                        StepCard {
                            open: root.open-step == 5;
                            tint: Theme.blue;
                            soft: Theme.blue-soft;
                            StepHeader {
                                number: "5";
                                title: "Statistics";
                                summary: root.has-preview ? root.stats-summary : "After preview";
                                done: false;
                                tint: Theme.blue;
                                tip: "See which photos the mosaic uses, how often, and with which camera settings.";
                                clicked => {
                                    root.open-step = 5;
                                    root.show-stats();
                                }
                            }
                            if root.open-step == 5: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Tipped {
                                        tip: !root.has-preview ? "Make a preview first. The statistics are about the photos in your mosaic." : "Show which photos the mosaic uses, how often, and the camera settings of the photos.";
                                        ColorButton {
                                            text: "Show statistics";
                                            tint: Theme.blue;
                                            enabled: !root.busy && root.has-preview;
                                            clicked => { root.show-stats(); }
                                        }
                                    }
                                    Tipped {
                                        tip: "Save the statistics as a JSON file. Each export also saves this file next to the mosaic.";
                                        LinkButton {
                                            text: "Save as JSON…";
                                            tint: Theme.blue;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            clicked => { root.save-stats-json(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Drag the divider to resize the steps without covering the preview.
            Rectangle {
                width: 8px;
                background: resize-handle.has-hover || resize-handle.pressed ? Theme.blue-soft : Theme.bg;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: 2px;
                    background: resize-handle.has-hover || resize-handle.pressed ? Theme.blue : Theme.line;
                }
                resize-handle := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.steps-width = clamp(steps-panel.width + self.mouse-x - self.pressed-x, 360px, root.max-steps-width);
                        }
                    }
                }
                Tooltip { TipBox { text: "Drag to resize the left panel."; } }
            }

            // ===================== right side: preview, suggestions or info
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                horizontal-stretch: 1;

                if root.update-message != "": Rectangle {
                    border-radius: 8px;
                    background: Theme.blue-soft;
                    border-width: 1px;
                    border-color: Theme.blue;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Text { text: root.update-message; color: Theme.fg; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.update-version != "": Tipped {
                            tip: "Open the download page in your web browser.";
                            ColorButton { text: "Download"; tint: Theme.blue; clicked => { root.update-download(); } }
                        }
                        if root.update-version != "": LinkButton {
                            text: "Ignore this version";
                            vertical-alignment: center;
                            clicked => { root.update-ignore(); }
                        }
                        LinkButton {
                            text: root.update-version != "" ? "Later" : "OK";
                            vertical-alignment: center;
                            clicked => { root.update-message = ""; }
                        }
                    }
                }

                if root.notice != "": Rectangle {
                    border-radius: 8px;
                    background: Theme.coral-soft;
                    border-width: 1px;
                    border-color: Theme.coral;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Text { text: root.notice; color: Theme.fg; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                        LinkButton { text: "Dismiss"; clicked => { root.notice = ""; } }
                    }
                }

                if root.main-view == 0: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        ColorButton {
                            text: root.has-preview ? "Update preview" : "Make preview";
                            tint: Theme.amber;
                            enabled: !root.busy;
                            clicked => { root.generate(); }
                        }
                        if root.has-preview: Tipped {
                            tip: "Choose different photos for this motif while keeping its size, style and shape.";
                            Button {
                                text: "New photo selection";
                                enabled: !root.busy && !root.preview-stale;
                                clicked => { root.new-selection(); }
                            }
                        }
                        if root.has-preview && root.preview-stale: Text {
                            text: "● Settings changed since this preview";
                            color: Theme.coral;
                            font-weight: 600;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.line;
                        if root.has-preview: ZoomView {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            base: root.preview-image;
                            detail: root.preview-detail;
                            has-detail: root.preview-has-detail;
                            detail-uv: root.preview-detail-uv;
                            sharpening: root.preview-sharpening;
                            hover-label: root.preview-hover-label;
                            max-zoom: root.preview-max-zoom;
                            dim: root.preview-stale ? 0.7 : 1.0;
                            zoom <=> root.preview-zoom;
                            cx <=> root.preview-cx;
                            cy <=> root.preview-cy;
                            distance <=> root.preview-distance;
                            artwork-mm: root.preview-artwork-mm;
                            soft-tiles: root.preview-soft-tiles;
                            view-changed(z, x, y, iw, ih, vw, vh) => { root.preview-view-changed(z, x, y, iw, ih, vw, vh); }
                            hover(u, v) => { root.preview-hover(u, v); }
                            info: root.tile-info;
                            marks: root.tile-marks;
                            goto-u: root.preview-goto-u;
                            goto-v: root.preview-goto-v;
                            goto-n: root.preview-goto-n;
                            tile-clicked(u, v) => { root.preview-tile-clicked(u, v); }
                            tile-inspect(u, v) => { root.preview-tile-inspect(u, v); }
                            open-photo => { root.tile-open-photo(); }
                            show-folder => { root.tile-show-folder(); }
                            next-use => { root.tile-next-use(); }
                            close-info => { root.tile-close(); }
                        }
                        if !root.has-preview: VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "Your mosaic will appear here"; font-size: 18px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
                            Text {
                                text: root.photo-count == 0 ? "Start with step 1: add a folder of photos." : root.motif-path == "" ? "Next, choose a picture in step 2." : "Press Make preview.";
                                color: Theme.muted;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    if root.has-preview: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip { text: root.chip-photos; dot: Theme.teal; }
                        Chip { text: root.chip-distance; dot: Theme.amber; }
                        Chip { text: root.chip-repeats; dot: Theme.coral; }
                        if root.chip-soft != "": Chip { text: root.chip-soft; dot: Theme.coral; }
                        LinkButton {
                            text: "Details";
                            vertical-alignment: center;
                            clicked => {
                                root.info-title = "Preview details";
                                root.info-text = root.match-report;
                                root.main-view = 2;
                            }
                        }
                    }
                }

                if root.main-view == 1: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Tipped {
                            horizontal-stretch: 1;
                            tip: "The app gives each picture a score. The score shows how well your photos can copy the picture at the current size and style. It does not show if a picture is beautiful.";
                            Text { text: "Help me choose a picture"; font-size: 18px; font-weight: 700; color: Theme.fg; }
                            HelpDot { }
                        }
                        LinkButton { text: "Back to preview"; tint: Theme.coral; font-weight: 600; vertical-alignment: center; clicked => { root.main-view = 0; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { placeholder-text: "Folder of pictures to try (optional)"; text <=> root.suggest-folder; }
                        Button { text: "Browse…"; clicked => { root.browse-suggest-folder(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Also try this many of my own photos:"; font-size: 13px; }
                        SpinBox { width: 140px; minimum: 0; maximum: 500; value <=> root.suggest-from-library; }
                        Rectangle { horizontal-stretch: 1; }
                        Tipped { tip: "Test the pictures in the folder above and some of your own photos. The best pictures show first."; ColorButton { text: "Find good pictures"; tint: Theme.coral; enabled: !root.busy; clicked => { root.suggest(); } } }
                    }
                    Hint { text: root.suggest-report; }
                    sugg-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: sugg-scroll.visible-width;
                            spacing: 6px;
                            alignment: start;
                            for s[i] in root.suggestions: Rectangle {
                                height: 110px;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.line;
                                HorizontalLayout {
                                    padding: 6px;
                                    spacing: 10px;
                                    Image { source: s.picture; width: 130px; image-fit: contain; }
                                    if s.has-preview: Image { source: s.preview; width: 130px; image-fit: contain; }
                                    VerticalLayout {
                                        Text { text: s.score + "  " + s.label; font-weight: 600; color: Theme.fg; overflow: elide; }
                                        Hint { text: s.notes; vertical-stretch: 1; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ColorButton { text: "Use"; tint: Theme.coral; enabled: s.path != ""; clicked => { root.use-suggestion(i); } }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.main-view == 3: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Statistics"; font-size: 18px; font-weight: 700; color: Theme.fg; horizontal-stretch: 1; }
                        LinkButton { text: "Save as JSON…"; tint: Theme.blue; font-weight: 600; vertical-alignment: center; clicked => { root.save-stats-json(); } }
                        Rectangle { width: 16px; }
                        LinkButton { text: "Back to preview"; tint: Theme.blue; font-weight: 600; vertical-alignment: center; clicked => { root.main-view = 0; } }
                    }
                    if root.stats-note != "": Hint { text: root.stats-note; }
                    stats-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: stats-scroll.visible-width - 14px;
                            spacing: 12px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 10px;
                                for f[i] in root.stat-figures: FigureTile {
                                    label: f.label;
                                    value: f.value;
                                    tint: Theme.chart-colors[i];
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    for c[i] in root.stat-charts-left: BarChart { chart: c; tint: Theme.chart-colors[i * 2]; }
                                }
                                VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    for c[i] in root.stat-charts-right: BarChart { chart: c; tint: Theme.chart-colors[i * 2 + 1]; }
                                }
                            }
                        }
                    }
                }

                if root.main-view == 4: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { width: 6px; border-radius: 3px; background: Theme.teal; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: "Is this the right folder?"; font-size: 18px; font-weight: 700; color: Theme.fg; }
                            Text { text: root.check-folder; font-size: 12px; color: Theme.muted; overflow: elide; }
                        }
                    }
                    Text { text: root.check-summary; font-size: 14px; font-weight: 600; color: root.check-done && root.check-count == 0 ? Theme.coral : Theme.fg; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        ColorButton {
                            text: "Use this folder";
                            tint: Theme.teal;
                            enabled: !root.busy && root.check-count > 0;
                            clicked => { root.confirm-folder(); }
                        }
                        ColorButton {
                            text: "Pick another folder…";
                            tint: Theme.muted;
                            enabled: !root.busy;
                            clicked => { root.add-folder(); }
                        }
                        LinkButton { text: "Cancel"; font-weight: 600; vertical-alignment: center; clicked => { root.cancel-folder-check(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.line;
                        clip: true;
                        check-scroll := ScrollView {
                            property <length> cell: 132px;
                            property <int> per-row: max(1, floor((check-scroll.visible-width - 12px) / (cell + 6px)));
                            content-height: ceil(root.check-thumbs.length / per-row) * (cell + 6px) + 12px;
                            for t[i] in root.check-thumbs: Rectangle {
                                x: 8px + mod(i, check-scroll.per-row) * (check-scroll.cell + 6px);
                                y: 8px + floor(i / check-scroll.per-row) * (check-scroll.cell + 6px);
                                width: check-scroll.cell;
                                height: check-scroll.cell;
                                border-radius: 6px;
                                clip: true;
                                background: Theme.line;
                                Image { source: t; width: parent.width; height: parent.height; image-fit: cover; }
                            }
                        }
                    }
                }

                if root.main-view == 5: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Help"; font-size: 18px; font-weight: 700; color: Theme.fg; horizontal-stretch: 1; }
                        LinkButton { text: "Back to preview"; font-weight: 600; vertical-alignment: center; clicked => { root.main-view = 0; } }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        vertical-stretch: 1;
                        // Topic list
                        VerticalLayout {
                            width: 200px;
                            spacing: 4px;
                            alignment: start;
                            for t[i] in root.help-topics: Rectangle {
                                height: 34px;
                                border-radius: 8px;
                                background: i == root.help-topic ? Theme.surface : (hta.has-hover ? Theme.line : transparent);
                                border-width: i == root.help-topic ? 1px : 0px;
                                border-color: Theme.line;
                                hta := TouchArea { mouse-cursor: pointer; clicked => { root.help-topic = i; } }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    spacing: 8px;
                                    Rectangle { width: 4px; height: 18px; y: 8px; border-radius: 2px; background: t.tint; }
                                    Text { text: t.title; font-size: 13px; font-weight: i == root.help-topic ? 700 : 400; color: Theme.fg; vertical-alignment: center; }
                                }
                            }
                        }
                        // Topic page
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.line;
                            clip: true;
                            help-scroll := ScrollView {
                                property <HelpTopic> t: root.help-topics[root.help-topic];
                                // Start each topic at the top.
                                property <int> topic: root.help-topic;
                                changed topic => { self.content-y = 0; }
                                property <length> text-w: min(help-scroll.visible-width - 48px, 720px);
                                VerticalLayout {
                                    width: help-scroll.visible-width;
                                    padding: 24px;
                                    spacing: 12px;
                                    alignment: start;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle { width: 6px; border-radius: 3px; background: help-scroll.t.tint; }
                                        Text { text: help-scroll.t.title; font-size: 22px; font-weight: 700; color: Theme.fg; }
                                    }
                                    Text { text: help-scroll.t.intro; width: help-scroll.text-w; wrap: word-wrap; font-size: 14px; color: Theme.fg; }
                                    Rectangle {
                                        height: min(460px, (help-scroll.visible-width - 48px) * help-scroll.t.picture.height / max(1, help-scroll.t.picture.width));
                                        border-radius: 8px;
                                        background: Theme.bg;
                                        Image {
                                            source: help-scroll.t.picture;
                                            image-fit: contain;
                                            width: parent.width - 12px;
                                            height: parent.height - 12px;
                                        }
                                    }
                                    if help-scroll.t.steps.length > 0: Text { text: "Do these steps"; font-size: 15px; font-weight: 700; color: Theme.fg; }
                                    for s[i] in help-scroll.t.steps: HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: help-scroll.t.tint;
                                            Text { text: i + 1; color: #ffffff; font-size: 12px; font-weight: 700; }
                                        }
                                        Text { text: s; width: help-scroll.text-w - 32px; wrap: word-wrap; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                                    }
                                    if help-scroll.t.notes.length > 0: Text { text: help-scroll.t.steps.length > 0 ? "Good to know" : "Problems and what to do"; font-size: 15px; font-weight: 700; color: Theme.fg; }
                                    for n in help-scroll.t.notes: HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            width: 22px;
                                            Rectangle { width: 6px; height: 6px; y: 7px; border-radius: 3px; background: help-scroll.t.tint; }
                                        }
                                        Text { text: n; width: help-scroll.text-w - 32px; wrap: word-wrap; font-size: 13px; color: Theme.fg; }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.main-view == 2: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.info-title; font-size: 18px; font-weight: 700; color: Theme.fg; horizontal-stretch: 1; }
                        LinkButton { text: "Back to preview"; font-weight: 600; vertical-alignment: center; clicked => { root.main-view = 0; } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 8px;
                        ScrollView {
                            Text { text: root.info-text; wrap: word-wrap; color: Theme.fg; font-size: 12px; width: parent.width - 24px; x: 12px; y: 8px; }
                        }
                    }
                }
            }
        }

        // ===================== status bar
        Rectangle {
            height: 40px;
            background: Theme.surface;
            Rectangle { height: 1px; y: 0; background: Theme.line; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;
                Rectangle {
                    width: 220px;
                    height: 6px;
                    y: 17px;
                    border-radius: 3px;
                    background: Theme.line;
                    clip: true;
                    Rectangle {
                        x: 0;
                        height: parent.height;
                        width: root.progress-known ? parent.width * root.progress : (root.busy ? parent.width * 0.35 : 0);
                        background: @linear-gradient(90deg, Theme.teal 0%, Theme.violet 100%);
                        // Pulse while working so it is clear the app has not frozen.
                        opacity: root.busy ? 0.65 + 0.35 * Math.sin(animation-tick() / 1000ms * 360deg) : 1;
                    }
                }
                if root.busy: Spinner { y: 11px; }
                Text { text: root.status; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if root.busy: Button { text: "Cancel"; clicked => { root.cancel(); } }
                if !root.busy && root.photos-indexed: HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: 11px;
                        border-radius: 9px;
                        background: Theme.teal;
                        Text { text: "✓"; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: root.photos-summary + " indexed"; color: Theme.fg; font-size: 12px; vertical-alignment: center; }
                }
                Text { text: "Made with Slint"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
        }
    }
}
